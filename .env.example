# OPSFORGE local/training secrets and defaults.
# Copy to .env before running Docker Compose or release scripts.
# Never reuse these example values outside the local simulation environment.

APP_ENV=dev
RELEASE_VERSION=dev

POSTGRES_USER=nightwatch
POSTGRES_DB=nightwatch
POSTGRES_PASSWORD=change-me-local-postgres

RABBITMQ_USER=nightwatch
RABBITMQ_PASSWORD=change-me-local-rabbitmq

GRAFANA_ADMIN_USER=opsforge
GRAFANA_ADMIN_PASSWORD=change-me-local-grafana
